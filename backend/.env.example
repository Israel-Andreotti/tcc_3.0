SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

DB_NAME=tcc_chamados
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Em produção, use a connection string do Postgres hospedado (ex.: Neon).
# Quando definida, tem prioridade sobre as variáveis DB_* acima.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Object storage para imagens e anexos (Cloudflare R2, AWS S3 ou Supabase Storage).
# Sem STORAGE_BUCKET, os arquivos vão para a pasta local backend/uploads/ (desenvolvimento).
# STORAGE_BUCKET=tcc-chamados
# STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto
# STORAGE_PUBLIC_DOMAIN=pub-xxxxxxxx.r2.dev
