SECRET_KEY=change-me
DEBUG=True
# Testes locais: "Entrar como..." sem senha na tela de login (exige DEBUG=True; nunca use em produção).
# LOGIN_RAPIDO=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

DB_NAME=tcc_chamados
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Em produção (Railway), referência ao Postgres do projeto: ${{Postgres.DATABASE_URL}}.
# Quando definida, tem prioridade sobre as variáveis DB_* acima.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Minutos sem uso até a sessão expirar (padrão 30).
# SESSAO_INATIVIDADE_MINUTOS=30
# Nível dos logs do Django no console (padrão WARNING).
# LOG_LEVEL=WARNING
